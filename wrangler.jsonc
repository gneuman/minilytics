{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minilytics",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; the dashboard and /js/script.js are served as free static files.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      "database_id": "9c3133c7-f477-4cfc-b2a4-561c729fab5d",
      "migrations_dir": "migrations"
    }
  ]
}
